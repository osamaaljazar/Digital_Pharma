@{
    ViewData["Title"] = "بحث عن دواء";
}

<div class="container mt-5 text-center">
    <h1>🔍 ابحث عن تفاعلات أي دواء</h1>

    <form asp-action="CheckInteraction" method="post" class="mt-4">
        <input type="text" name="drugName" class="form-control mb-3" placeholder="1 أدخل اسم الدواء" required />
        

        <input type="text" name="drugName" class="form-control mb-3" placeholder="2 أدخل اسم الدواء" required />
        <button type="submit" class="btn btn-primary">تحقق</button>
    </form>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3">
            @ViewBag.Error
        </div>
    }
</div>
