@{
    ViewData["Title"] = "فحص التداخل الدوائي";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4">💊 Digital Pharma </h1>
        <p class="lead">أدخل اسم دوائين للتحقق من وجود تداخلات كيميائية بينهما</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CheckInteraction" method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">الدواء الأول</label>
                                <input type="text" name="drugName1" class="form-control form-control-lg" placeholder="مثال: Aspirin" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">الدواء الثاني</label>
                                <input type="text" name="drugName2" class="form-control form-control-lg" placeholder="مثال: Warfarin" required />
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                🔍 بدء فحص التداخل
                            </button>
                        </div>
                    </form>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-warning mt-4 border-start border-4 border-warning">
                            @ViewBag.Error
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>