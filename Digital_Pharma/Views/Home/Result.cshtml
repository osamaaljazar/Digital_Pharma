@model Digital_Pharma.Models.InteractionAnalysis

@{
    ViewData["Title"] = "نتائج التحليل";
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2>:bar_chart: نتيجة الفحص المخبري</h2>
        <hr />
    </div>

    <!-- بطاقة الحالة (المنطق) -->
    <div class="row justify-content-center mb-4">
        <div class="col-md-10">
            @if (Model.InteractionFound)
            {
                <div class="card border-danger shadow">
                    <div class="card-body text-center bg-danger text-white">
                        <h3 class="card-title">:warning: تحذير: تم اكتشاف تداخل!</h3>
                        <p class="card-text">@Model.AnalysisMessage</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-success shadow">
                    <div class="card-body text-center bg-success text-white">
                        <h3 class="card-title">:white_check_mark: النتيجة سليمة ظاهرياً</h3>
                        <p class="card-text">@Model.AnalysisMessage</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- تفاصيل الأدوية المقارنة -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-dark text-white text-center">
                    دواء (A): @(Model.Drug1.OpenFda?.BrandName?.FirstOrDefault() ?? "غير متوفر")
                </div>
                <div class="card-body" dir="ltr">
                    <p><strong>Generic:</strong> @(Model.Drug1.OpenFda?.GenericName?.FirstOrDefault() ?? "N/A")</p>
                    <h6>Interactions Text Preview:</h6>
                    <div class="small text-muted overflow-auto" style="max-height: 150px;">
                        @if (Model.Drug1.DrugInteractions != null)
                        {
                            @string.Join(" ", Model.Drug1.DrugInteractions).Substring(0, Math.Min(300, string.Join(" ", Model.Drug1.DrugInteractions).Length))
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-dark text-white text-center">
                    دواء (B): @(Model.Drug2.OpenFda?.BrandName?.FirstOrDefault() ?? "غير متوفر")
                </div>
                <div class="card-body" dir="ltr">
                    <p><strong>Generic:</strong> @(Model.Drug2.OpenFda?.GenericName?.FirstOrDefault() ?? "N/A")</p>
                    <h6>Interactions Text Preview:</h6>
                    <div class="small text-muted overflow-auto" style="max-height: 150px;">
                        @if (Model.Drug2.DrugInteractions != null)
                        {
                            @string.Join(" ", Model.Drug2.DrugInteractions).Substring(0, Math.Min(300, string.Join(" ", Model.Drug2.DrugInteractions).Length))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <a asp-action="Index" class="btn btn-secondary btn-lg">العودة للبحث</a>
    </div>
</div>